# =========================================================================
# Unified Application & Infrastructure Configuration Example
# =========================================================================
#
# Copy this file to '.env' at the root of the repository for local development:
#   cp .env.example .env
#
# WARNING: Never commit '.env' to version control!
# =========================================================================

# === Container Configuration ===
CONTAINER_PREFIX=ai_agent

# === Project Setup ===
PROJECT_NAME=ai_agent
DEBUG=true
ENVIRONMENT=local
TIMEZONE=UTC  # IANA timezone: UTC, Europe/Warsaw, America/New_York
MODELS_CACHE_DIR=./models_cache

# === Observability & Logging ===
# Get your token at https://logfire.pydantic.dev
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=ai_agent
LOGFIRE_ENVIRONMENT=development
SENTRY_DSN=

# === PostgreSQL Database ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_agent

# === Redis Cache & Session Store ===
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-in-production
REDIS_DB=0
# REDIS_SSL=false

# === Authentication Secrets ===
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# === API Key Authentication ===
API_KEY=change-me-in-production
API_KEY_HEADER=X-API-Key

# === RAG & Knowledge Base ===
RAG_DEFAULT_COLLECTION=documents
RAG_TOP_K=10
PDF_PARSER=pymupdf  # RAG ingestion parser: pymupdf, llamaparse, liteparse
CHAT_PDF_PARSER=pymupdf  # Chat file attachment parser: pymupdf, llamaparse, liteparse
LLAMAPARSE_API_KEY=
LLAMAPARSE_TIER=agentic  # fast, cost_effective, agentic, agentic_plus
RAG_IMAGE_DESCRIPTION_MODEL=  # empty = use AI_MODEL

# === External S3 RAG Storage ===
S3_RAG_ENDPOINT=
S3_RAG_ACCESS_KEY=
S3_RAG_SECRET_KEY=
S3_RAG_BUCKET=ai_agent-rag
S3_RAG_REGION=us-east-1

# === CloudWatch & Prometheus Metrics ===
PROMETHEUS_METRICS_PATH=/metrics
PROMETHEUS_INCLUDE_IN_SCHEMA=false
CLOUDWATCH_METRICS_ENABLED=false
CLOUDWATCH_METRICS_NAMESPACE=webapp-group10/backend
CLOUDWATCH_METRICS_SERVICE_NAME=backend
CLOUDWATCH_METRICS_INTERVAL_SECONDS=60

# === S3 & EFS Storage ===
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ai_agent
S3_REGION=us-east-1
EFS_ID=

# === AWS Bedrock Converse Model ===
AWS_REGION=us-east-1
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_KB_DATA_SOURCE_ID=
BEDROCK_KB_S3_BUCKET=
BEDROCK_KB_S3_PREFIX=rag-documents/

# === AI Agent Config ===
AI_MODEL=us.anthropic.claude-sonnet-4-20250514
AI_TEMPERATURE=0.7

# === CORS Origins ===
# JSON list of allowed origins (Note: "*" is blocked in production - specify explicit origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# =========================================================================
# Frontend Configurations
# =========================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_RAG_ENABLED=true
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=10

# =========================================================================
# Infrastructure / Deployment Configurations
# =========================================================================
DOMAIN=example.com
DOMAIN_NAME=example.com
HOSTED_ZONE_ID=
ACM_CERTIFICATE_ARN=
ACME_EMAIL=admin@example.com

# AWS Templates / Lambdas
TEMPLATES_BUCKET=
TEMPLATES_PREFIX=
CONTAINER_IMAGE=
LAMBDA_S3_BUCKET=
LAMBDA_S3_KEY=
ENABLE_RDS_SSL=false
CREATE_OPENSEARCH=false
