# Copy this file to terraform.tfvars and fill in values

project_name = "webapp-group10"
aws_region   = "us-east-1"

rds_master_username = "postgres"
rds_master_password = "CHANGE_ME_MIN_8_CHARS"
enable_rds_ssl      = true

create_opensearch_collection = false

domain_name         = "aws.hungtran.id.vn"
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/replace-me"
hosted_zone_id      = ""

container_image = ""

lambda_s3_bucket = "replace-with-lambda-artifact-bucket"
lambda_s3_key    = "replace-with-lambda-artifact-key.zip"

backend_cpu           = 2048
backend_memory        = 4096
backend_desired_count = 6
backend_max_count     = 9
